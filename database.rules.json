{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['uid', 'displayName', 'email', 'role', 'points']) && newData.child('uid').val() === auth.uid && newData.child('role').val() === 'student' && newData.child('points').isNumber()"
      }
    },
    "community": {
      "posts": {
        ".read": "auth != null",
        "$postId": {
          ".write": "auth != null && ((!data.exists() && newData.child('authorUid').val() === auth.uid) || (data.exists() && data.child('authorUid').val() === auth.uid))"
        }
      }
    }
  }
}